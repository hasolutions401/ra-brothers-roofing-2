# InfinityFree. Copy to backend/.env.infinityfree and fill in the values marked
# FILL IN. `npm run package:infinityfree` reads it, generates APP_KEY and
# SETUP_TOKEN if they are empty (and saves them back here), and uploads it as
# htdocs/backend/.env. This file holds secrets: it is ignored by git.

APP_NAME="RA Brothers Roofing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# FILL IN: your InfinityFree address, https and no trailing slash,
# for example https://rabrothers.infinityfreeapp.com
APP_URL=https://your-site.infinityfreeapp.com
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning

# FILL IN from the control panel, MySQL Databases. The host is NOT localhost;
# it looks like sql123.infinityfree.com. Names look like if0_12345678_leads.
DB_CONNECTION=mysql
DB_HOST=sql000.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_00000000_leads
DB_USERNAME=if0_00000000
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true once the site loads over https (install the free SSL certificate first)
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# FILL IN: the dashboard account that /api/setup creates. At least 12 characters.
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# InfinityFree blocks outgoing email, so new-lead emails stay off here.
LEAD_NOTIFY_EMAIL=
MAIL_MAILER=log

BUSINESS_TIMEZONE=America/New_York
TRUSTED_PROXIES=cloudflare

# Generated by the package script if empty. Enter it at /api/setup once, then
# delete the value and upload .env again.
SETUP_TOKEN=
