# alwaysdata. The server's www/backend/.env; deploys never overwrite it.
# For a new install, copy this there, fill in the values marked FILL IN, then
# run over SSH: cd ~/www/backend && php artisan key:generate && php artisan migrate --force && php artisan db:seed --force
# After ANY change to this file, run: php artisan config:cache

APP_NAME="RA Brothers Roofing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# https and no trailing slash. Change it when the site moves to its own domain.
APP_URL=https://rabrothersroofing.alwaysdata.net
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# FILL IN from the alwaysdata admin, Databases > MySQL. Names start with the
# account name and an underscore.
DB_CONNECTION=mysql
DB_HOST=mysql-rabrothersroofing.alwaysdata.net
DB_PORT=3306
DB_DATABASE=rabrothersroofing_leads
DB_USERNAME=rabrothersroofing
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# FILL IN: the dashboard account. `php artisan db:seed --force` creates it
# or resets its password. At least 12 characters.
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# New-lead emails, sent through an alwaysdata mailbox (Emails > Addresses >
# Add, e.g. website@rabrothersroofing.alwaysdata.net). FILL IN its address and
# password, and LEAD_NOTIFY_EMAIL with the inbox the team reads. Then check
# delivery with: php artisan leads:test-email
# LEAD_CONFIRM_CUSTOMER=true also emails customers who gave an address a
# short "we received your request" note.
LEAD_NOTIFY_EMAIL=
LEAD_CONFIRM_CUSTOMER=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp-rabrothersroofing.alwaysdata.net
MAIL_PORT=465
MAIL_USERNAME=website@rabrothersroofing.alwaysdata.net
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="website@rabrothersroofing.alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"

BUSINESS_TIMEZONE=America/New_York
# If every lead in the dashboard shows the same IP address, that is
# alwaysdata's proxy: put that address here so rate limits see real visitors.
TRUSTED_PROXIES=cloudflare

# Not needed with SSH.
SETUP_TOKEN=
