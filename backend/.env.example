# Local development (Laragon or any PHP 8.3+ with MySQL).
# Copy to .env, then: php artisan key:generate && php artisan migrate --seed
# Hosting templates: .env.infinityfree.example and .env.hostinger.example

APP_NAME="RA Brothers Roofing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The Next.js site, including its base path. Used for CORS and the dashboard
# link in new-lead emails. `npm run dev` serves the site under the GitHub Pages path.
FRONTEND_URL=http://localhost:3000/ra-brothers-roofing-2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ra_roofing
DB_USERNAME=root
DB_PASSWORD=

# Files for sessions and cache: nothing extra to run, works on shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# The one dashboard account. `php artisan db:seed` creates it or resets its password.
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Optional email for each new lead. Leave empty to turn it off.
LEAD_NOTIFY_EMAIL=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="website@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BUSINESS_TIMEZONE=America/New_York
TRUSTED_PROXIES=cloudflare

# Browser-based database setup (/api/setup) for hosts without SSH. Not needed locally.
SETUP_TOKEN=
