# htdocs/backend/public/.htaccess
#
# Laravel's front controller. Requests only arrive here through the /api
# rewrite in htdocs/.htaccess, so nothing needs routing; the two rules below
# just make sure PHP receives headers some Apache setups drop (the dashboard
# sends X-XSRF-TOKEN with every change).

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]
</IfModule>
