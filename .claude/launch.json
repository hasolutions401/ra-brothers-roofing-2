{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ra-brothers-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "laravel-api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "backend/artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000/api/health"
    }
  ]
}
