# Local development of the Next.js site. Copy to .env.local.
# (Build settings for hosting are passed by scripts/package-alwaysdata.mjs
# and the deploy workflow, not read from here.)

# The Laravel API from `php artisan serve` in backend/. Leave empty to keep
# the forms in preview mode without a backend.
API_URL=http://localhost:8000/api

